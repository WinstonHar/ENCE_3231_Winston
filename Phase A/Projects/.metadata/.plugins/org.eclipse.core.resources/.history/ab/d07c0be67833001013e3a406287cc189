void ProcessBatteryVoltage(void) {
    uint32_t raw_adc;

#if ADC_NROFCONVERSIONS == 1
    raw_adc = gADC_Value;
#else
    raw_adc = gADC_Values[0]; // Assuming battery voltage is the first channel
#endif

    // Convert ADC raw value to millivolts
    // V_adc = raw_adc * (VREF_MV / ADC_MAX_VALUE)
    // V_battery = V_adc * VOLTAGE_DIVIDER_RATIO
    gBatteryVoltage_mV = (uint32_t)(((float)raw_adc * VREF_MV / ADC_MAX_VALUE) * VOLTAGE_DIVIDER_RATIO);

    // Hysteresis for battery state
    if (gBatteryState == BATT_VERY_LOW) {
        if (gBatteryVoltage_mV > BATT_THRESHOLD_RESTART_MV) {
            gBatteryState = BATT_OK;
            gMotorsEnabledByBattery = 1;
        }
    } else if (gBatteryState == BATT_LOW_SHUTDOWN) {
         if (gBatteryVoltage_mV > BATT_THRESHOLD_RESTART_MV) {
            gBatteryState = BATT_OK;
            gMotorsEnabledByBattery = 1;
        } else if (gBatteryVoltage_mV < BATT_THRESHOLD_LOW_MV) {
            gBatteryState = BATT_VERY_LOW;
            gMotorsEnabledByBattery = 0;
        }
    }
    else { // BATT_OK
        if (gBatteryVoltage_mV < BATT_THRESHOLD_LOW_MV) {
            gBatteryState = BATT_VERY_LOW; // Or BATT_LOW_SHUTDOWN if you want a distinct state
            gMotorsEnabledByBattery = 0;
        }
    }

    // For debugging (optional, requires UART setup)
    // printf("Battery Voltage: %lu mV, State: %d\r\n", gBatteryVoltage_mV, gBatteryState);
}

void SetMotorSpeed(uint16_t duty_cycle) {
    if (duty_cycle > MOTOR_PWM_MAX_DUTY) {
        duty_cycle = MOTOR_PWM_MAX_DUTY;
    }
    __HAL_TIM_SET_COMPARE(&MOTOR_PWM_TIMER, MOTOR_PWM_CHANNEL, duty_cycle);
}

void SetMotorDirection(MotorState_t command) {
    if (!gMotorsEnabledByBattery) { // If battery is too low, force stop
        HAL_GPIO_WritePin(MOTOR_IN1_GPIO_Port, MOTOR_IN1_Pin, GPIO_PIN_RESET); // Use labels from CubeMX
        HAL_GPIO_WritePin(MOTOR_IN2_GPIO_Port, MOTOR_IN2_Pin, GPIO_PIN_RESET);
        SetMotorSpeed(0);
        return;
    }

    switch (command) {
        case MOTOR_STOPPED:
            HAL_GPIO_WritePin(MOTOR_IN1_GPIO_Port, MOTOR_IN1_Pin, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(MOTOR_IN2_GPIO_Port, MOTOR_IN2_Pin, GPIO_PIN_RESET);
            SetMotorSpeed(0);
            break;
        case MOTOR_CCW:
            HAL_GPIO_WritePin(MOTOR_IN1_GPIO_Port, MOTOR_IN1_Pin, GPIO_PIN_SET);
            HAL_GPIO_WritePin(MOTOR_IN2_GPIO_Port, MOTOR_IN2_Pin, GPIO_PIN_RESET);
            // Note: Actual IN1/IN2 for CCW/CW depends on your wiring to the motor driver
            SetMotorSpeed(MOTOR_DEFAULT_SPEED_DUTY);
            break;
        case MOTOR_CW:
            HAL_GPIO_WritePin(MOTOR_IN1_GPIO_Port, MOTOR_IN1_Pin, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(MOTOR_IN2_GPIO_Port, MOTOR_IN2_Pin, GPIO_PIN_SET);
            SetMotorSpeed(MOTOR_DEFAULT_SPEED_DUTY);
            break;
        default:
            HAL_GPIO_WritePin(MOTOR_IN1_GPIO_Port, MOTOR_IN1_Pin, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(MOTOR_IN2_GPIO_Port, MOTOR_IN2_Pin, GPIO_PIN_RESET);
            SetMotorSpeed(0);
            break;
    }
}

void ControlMotors(void) {
    SetMotorDirection(gMotorCommand);
}

void ProcessButtonClicks(void) {
    // This function is called periodically from the main loop to check if a multi-click timeout has occurred.
    if (gButtonClickCount > 0 && (HAL_GetTick() - gLastButtonPressTime > BUTTON_MULTICLICK_TIMEOUT_MS)) {
        if (gButtonClickCount == 1) {
            gMotorCommand = MOTOR_STOPPED;
        } else if (gButtonClickCount == 2) {
            gMotorCommand = MOTOR_CCW;
        } else if (gButtonClickCount >= 3) { // More than 3 clicks also results in CW
            gMotorCommand = MOTOR_CW;
        }
        gButtonClickCount = 0; // Reset for next sequence
        // printf("Button Clicks Processed: %d -> Motor Command: %d\r\n", tempClickCount, gMotorCommand);
    }
}

