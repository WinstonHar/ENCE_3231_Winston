/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_I2C1_Init();
  MX_I2S3_Init();
  MX_SPI1_Init();
  MX_USB_HOST_Init();
  MX_ADC1_Init();
  MX_TIM2_Init();
  /* USER CODE BEGIN 2 */
  // Start ADC with DMA
  #if ADC_NROFCONVERSIONS == 1
    if (HAL_ADC_Start_DMA(&hadc1, (uint32_t*)&gADC_Value, 1) != HAL_OK) {
        Error_Handler();
    }
  #else
    if (HAL_ADC_Start_DMA(&hadc1, (uint32_t*)gADC_Values, 1) != HAL_OK) { // Still read 1 value into the array
        Error_Handler();
    }
  #endif

    // Start PWM Timer
    if (HAL_TIM_PWM_Start(&MOTOR_PWM_TIMER, MOTOR_PWM_CHANNEL) != HAL_OK) {
        Error_Handler();
    }
    SetMotorSpeed(0); // Ensure motors are off at start

    gMotorCommand = MOTOR_STOPPED; // Initial motor state
    SetMotorDirection(gMotorCommand);

  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  uint32_t last_adc_check_time = HAL_GetTick();

  while (1)
  {
    /* USER CODE END WHILE */
    MX_USB_HOST_Process();

    /* USER CODE BEGIN 3 */
    uint32_t current_time = HAL_GetTick();

    // Process ADC data periodically (e.g., every 100ms)
    if (gFlag_ADC_Finished == 1) {
            gFlag_ADC_Finished = 0;
            ProcessBatteryVoltage(); // Process the new ADC value

            // Restart DMA for next conversion after processing
    #if ADC_NROFCONVERSIONS == 1
            if (HAL_ADC_Start_DMA(&hadc1, (uint32_t*)&gADC_Value, 1) != HAL_OK) {
                Error_Handler(); // Or handle error more gracefully
            }
    #else
            if (HAL_ADC_Start_DMA(&hadc1, (uint32_t*)gADC_Values, 1) != HAL_OK) {
                Error_Handler();
            }
    #endif
    }


	// Check for button click timeout
	ProcessButtonClicks();

	// Apply motor commands based on battery and button
	ControlMotors();

	// Minimal delay to allow other tasks/interrupts, ADC runs on DMA
	HAL_Delay(10); // Adjust as needed, e.g. 10-50ms
  }
  /* USER CODE END 3 */
}

