// External Interrupt Callback for Button
void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin) {
    uint32_t current_tick = HAL_GetTick();

    // Check which pin triggered the interrupt (replace EXT_BUTTON_Pin with your actual pin define from main.h)
    if (GPIO_Pin == EXT_BUTTON_Pin) { // EXT_BUTTON_Pin is defined by CubeMX based on User Label
        // Debounce: Check if enough time has passed since the last valid press/debounce check
        if ((current_tick - gButtonDebounceCheckTime) > BUTTON_DEBOUNCE_MS) {
            gButtonDebounceCheckTime = current_tick; // Update time for next debounce check

            // Multi-click logic
            if ((current_tick - gLastButtonPressTime) > BUTTON_MULTICLICK_TIMEOUT_MS || gButtonClickCount == 0) {
                // This is the first click of a new sequence (or timeout occurred)
                gButtonClickCount = 1;
            } else {
                // This is a subsequent click within the timeout window
                gButtonClickCount++;
            }
            gLastButtonPressTime = current_tick; // Record time of this valid (debounced) press
            // printf("Button Press Detected! Clicks: %d\r\n", gButtonClickCount);
        }
    }
}

