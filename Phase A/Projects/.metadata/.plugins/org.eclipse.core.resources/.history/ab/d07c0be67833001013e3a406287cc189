// *** IMPORTANT: CALIBRATE THIS Voltage Divider Ratio ***
// Example: If R1=10k, R2=5.6k, Ratio = (10k + 5.6k) / 5.6k = 15.6 / 5.6 = 2.7857
#define VOLTAGE_DIVIDER_RATIO       2.7857f // (R1+R2)/R2 for your voltage divider
